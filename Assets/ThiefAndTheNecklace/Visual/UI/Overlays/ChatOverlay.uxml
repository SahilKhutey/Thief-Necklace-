<ui:UXML xmlns:ui="UnityEngine.UIElements"><Style src="../Foundations/Resources/DesignTokens.uss"/><Style src="../USS/TANComponents.uss"/><Style src="../Screens/PV2Screens.uss"/><ui:VisualElement name="overlay-root" class="tn-modal pv2-overlay"><ui:VisualElement class="tn-modal__backdrop"/><ui:VisualElement class="tn-modal__frame"><ui:VisualElement class="tn-modal__header-row"><ui:Label text="CHAT" class="tn-modal__header"/><ui:Button name="overlay-close" text="×" class="tn-modal__close"/></ui:VisualElement><ui:VisualElement class="tn-modal__body"><ui:Label text="TABLE CHAT" class="tn-headline"/><ui:ScrollView name="chat-messages"><ui:VisualElement class="tan-chat-message"><ui:Label text="QUEEN" class="tan-chat-message__sender"/><ui:Label text="I left before the blackout." class="tan-chat-message__content"/></ui:VisualElement><ui:VisualElement class="tan-chat-message"><ui:Label text="MINISTER" class="tan-chat-message__sender"/><ui:Label text="What time?" class="tan-chat-message__content"/></ui:VisualElement></ui:ScrollView><ui:Label name="chat-validation" text="" class="tn-state-error"/><ui:TextField name="chat-input" label="MESSAGE"/><ui:Button name="send-message" text="SEND" class="tan-button tan-button--primary"/><ui:Button name="overlay-close" text="CLOSE" class="tan-button tan-button--secondary"/></ui:VisualElement></ui:VisualElement></ui:VisualElement></ui:UXML>