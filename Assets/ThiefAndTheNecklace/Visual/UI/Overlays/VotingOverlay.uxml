<ui:UXML xmlns:ui="UnityEngine.UIElements"><Style src="../Foundations/Resources/DesignTokens.uss"/><Style src="../USS/TANComponents.uss"/><Style src="../Screens/PV2Screens.uss"/><ui:VisualElement name="overlay-root" class="tn-modal pv2-overlay"><ui:VisualElement class="tn-modal__backdrop"/><ui:VisualElement class="tn-modal__frame"><ui:VisualElement class="tn-modal__header-row"><ui:Label text="VOTING" class="tn-modal__header"/><ui:Button name="overlay-close" text="×" class="tn-modal__close"/></ui:VisualElement><ui:VisualElement class="tn-modal__body"><ui:Label name="vote-status" text="CAST YOUR VOTE" class="tn-headline"/><ui:Label text="Select another player. Your own seat cannot be selected." class="tn-body"/><ui:Label name="vote-progress" text="0 / 4 VOTES RECEIVED" class="tn-caption"/><ui:VisualElement name="candidate-list" class="pv2-player-grid"><ui:Button name="target-player-2" text="PLAYER 2" class="tan-button tan-button--secondary"/><ui:Button name="target-player-3" text="PLAYER 3" class="tan-button tan-button--secondary"/><ui:Button name="target-player-4" text="PLAYER 4" class="tan-button tan-button--secondary"/><ui:Button name="target-local" text="YOU — NOT ELIGIBLE" class="tan-button" disabled="true"/></ui:VisualElement><ui:VisualElement class="pv2-vote-actions"><ui:Button name="submit-vote" text="SUBMIT VOTE" class="tan-button tan-button--primary" disabled="true"/><ui:Button name="overlay-close" text="CANCEL" class="tan-button tan-button--ghost"/></ui:VisualElement></ui:VisualElement></ui:VisualElement></ui:VisualElement></ui:UXML>
