<ui:UXML xmlns:ui="UnityEngine.UIElements"><Style src="../Foundations/Resources/DesignTokens.uss"/><Style src="../USS/TANComponents.uss"/><Style src="PV2Screens.uss"/><ui:VisualElement name="screen-root" class="tn-screen pv2-screen"><ui:VisualElement class="tn-screen-background pv2-background"/><ui:VisualElement class="pv2-frame"><ui:VisualElement class="pv2-topbar"><ui:Button name="screen-back" text="‹" class="tan-icon-button"/><ui:Label name="screen-title" text="RECONNECTING" class="pv2-top-title"/><ui:Label name="screen-status" text="" class="tan-badge tan-badge--info"/></ui:VisualElement><ui:VisualElement class="pv2-content"><ui:Label name="screen-subtitle" text="Restoring your connection…" class="tn-headline"/><ui:VisualElement name="primary-content" class="pv2-primary-content"><ui:Label text="RECONNECTING" class="pv2-screen-heading"/><ui:Label text="Restoring your connection…" class="tn-body"/><ui:Label text="Attempt 2 / 5" class="tn-body"/><ui:VisualElement class="tan-timer"><ui:Label text="•••" class="tan-timer__time"/></ui:VisualElement><ui:Button name="go-disconnected" text="CANCEL" class="tan-button tan-button--ghost"/></ui:VisualElement></ui:VisualElement><ui:VisualElement name="screen-overlay" class="tn-screen-overlay"/></ui:VisualElement></ui:VisualElement></ui:UXML>