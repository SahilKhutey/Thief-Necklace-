<ui:UXML xmlns:ui="UnityEngine.UIElements"><Style src="../Foundations/Resources/DesignTokens.uss"/><Style src="../USS/TANComponents.uss"/><Style src="PV2Screens.uss"/><ui:VisualElement name="screen-root" class="tn-screen pv2-screen"><ui:VisualElement class="tn-screen-background pv2-background"/><ui:VisualElement class="pv2-frame"><ui:VisualElement class="pv2-topbar"><ui:Button name="screen-back" text="‹" class="tan-icon-button"/><ui:Label name="screen-title" text="CREATE ROOM" class="pv2-top-title"/><ui:Label name="screen-status" text="" class="tan-badge tan-badge--info"/></ui:VisualElement><ui:VisualElement class="pv2-content"><ui:Label name="screen-subtitle" text="Gather your players" class="tn-headline"/><ui:VisualElement name="primary-content" class="pv2-primary-content"><ui:Label text="CREATE ROOM" class="pv2-screen-heading"/><ui:Label text="Gather your players" class="tn-body"/><ui:TextField name="room-name" label="ROOM NAME" value="Royal Mystery"/><ui:DropdownField label="PLAYERS" choices="4,5,6"/><ui:DropdownField label="DIFFICULTY" choices="Easy,Normal,Hard"/><ui:Label name="validation-message" text="" class="tn-state-error"/><ui:Button name="create-room-submit" text="CREATE ROOM" class="tan-button tan-button--primary"/><ui:Button name="screen-back" text="BACK" class="tan-button tan-button--ghost"/></ui:VisualElement></ui:VisualElement><ui:VisualElement name="screen-overlay" class="tn-screen-overlay"/></ui:VisualElement></ui:VisualElement></ui:UXML>