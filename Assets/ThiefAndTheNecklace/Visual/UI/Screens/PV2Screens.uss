.pv2-screen { flex-grow: 1; min-height: 100%; background-color: var(--royal-ink, #211813); }
.pv2-background { background-color: var(--royal-ink-soft, #30231c); }
.pv2-frame { flex-grow: 1; align-items: center; padding: var(--space-4, 16px); }
.pv2-topbar { width: 100%; max-width: 1100px; min-height: 56px; flex-direction: row; align-items: center; justify-content: space-between; border-bottom-width: 1px; border-bottom-color: var(--royal-border, #896b3d); }
.pv2-top-title { flex-grow: 1; color: var(--royal-ivory, #f5ecd0); font-size: 18px; -unity-font-style: bold; -unity-text-align: middle-center; }
.pv2-content { width: 100%; max-width: 960px; flex-grow: 1; align-items: center; justify-content: center; padding: var(--space-4, 16px); }
.pv2-content > .tn-body, .pv2-content > .pv2-screen-heading { margin-bottom: var(--space-3, 12px); }
.pv2-screen-heading { color: var(--royal-ivory, #f5ecd0); font-size: 30px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; }
.pv2-primary-content { width: 100%; max-width: 760px; align-items: center; justify-content: center; }
.pv2-primary-content > .tan-button, .pv2-primary-content > .tan-panel, .pv2-primary-content > .pv2-art-panel { width: 100%; max-width: 560px; margin-top: var(--space-2, 8px); margin-bottom: var(--space-2, 8px); }
.pv2-brand-crest { width: 84px; height: 84px; align-items: center; justify-content: center; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-color: var(--royal-gold, #c69a45); border-right-color: var(--royal-gold, #c69a45); border-bottom-color: var(--royal-gold, #c69a45); border-left-color: var(--royal-gold, #c69a45); border-top-left-radius: 42px; border-top-right-radius: 42px; border-bottom-left-radius: 42px; border-bottom-right-radius: 42px; }
.pv2-crest { color: var(--royal-gold, #c69a45); font-size: 48px; -unity-text-align: middle-center; }
.pv2-art-panel { min-height: 180px; align-items: center; justify-content: center; background-color: var(--royal-surface, #382920); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-color: var(--royal-border, #896b3d); border-right-color: var(--royal-border, #896b3d); border-bottom-color: var(--royal-border, #896b3d); border-left-color: var(--royal-border, #896b3d); }
.pv2-art-symbol { color: var(--royal-gold, #c69a45); font-size: 64px; }
.pv2-player-grid { width: 100%; flex-direction: row; flex-wrap: wrap; justify-content: center; }
.pv2-player-grid > .tan-player-card { flex-grow: 1; min-width: 210px; margin: var(--space-2, 8px); }
.pv2-game-layout { width: 100%; min-height: 440px; flex-direction: row; align-items: stretch; justify-content: space-between; }
.pv2-game-rail { width: 24%; min-width: 180px; justify-content: space-around; }
.pv2-game-rail > .tan-player-card { margin-top: var(--space-2, 8px); margin-bottom: var(--space-2, 8px); }
.pv2-table { flex-grow: 1; margin-left: var(--space-3, 12px); margin-right: var(--space-3, 12px); align-items: center; justify-content: center; background-color: var(--royal-surface, #382920); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-color: var(--royal-gold, #c69a45); border-right-color: var(--royal-gold, #c69a45); border-bottom-color: var(--royal-gold, #c69a45); border-left-color: var(--royal-gold, #c69a45); border-top-left-radius: 100px; border-top-right-radius: 100px; border-bottom-left-radius: 100px; border-bottom-right-radius: 100px; }
.pv2-necklace { color: var(--royal-gold, #c69a45); font-size: 56px; }
.tn-high-contrast .pv2-frame { background-color: #000; }
.tn-large-text .pv2-screen-heading { font-size: 38px; }
.tn-reduced-motion .pv2-screen { transition-duration: 0ms; }

.pv2-page-container { width: 100%; max-width: 720px; min-height: 220px; justify-content: center; }
.pv2-tutorial-page { align-items: center; justify-content: center; padding: var(--space-5, 24px); }
.pv2-vote-actions { flex-direction: row; align-items: center; justify-content: center; flex-wrap: wrap; }
.pv2-vote-actions > .tan-button { min-width: 140px; margin: var(--space-2, 8px); }
.pv2-overlay { z-index: 10; }
.tn-screen-host { flex-grow: 1; position: relative; }
.tn-screen-layer { flex-grow: 1; }
.tn-overlay-layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }

.tn-state-error { color: var(--royal-error, #b64c47); white-space: normal; }


.pv2-table { position: relative; }
.pv2-seat-layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.pv2-seat { position: absolute; width: 120px; min-height: 68px; flex-direction: column; align-items: center; justify-content: center; padding: var(--space-2, 8px); background-color: var(--royal-ink-soft, #30231c); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-color: var(--royal-gold, #c69a45); border-right-color: var(--royal-gold, #c69a45); border-bottom-color: var(--royal-gold, #c69a45); border-left-color: var(--royal-gold, #c69a45); border-top-left-radius: var(--radius-md, 14px); border-top-right-radius: var(--radius-md, 14px); border-bottom-left-radius: var(--radius-md, 14px); border-bottom-right-radius: var(--radius-md, 14px); }
.pv2-seat__name { color: var(--royal-ivory, #f5ecd0); font-size: 12px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; }
.pv2-seat__status { color: var(--royal-parchment, #d8c49b); font-size: 10px; -unity-text-align: middle-center; }
.pv2-seat--local { border-bottom-width: 4px; border-bottom-color: var(--royal-gold, #c69a45); }


.pv2-rank-list { width: 100%; }
.pv2-rank-list > .tan-player-card { flex-direction: row; align-items: center; }
