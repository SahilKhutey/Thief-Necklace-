<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <Style src="../Foundations/Resources/DesignTokens.uss"/><Style src="../USS/TANComponents.uss"/><Style src="PV2Screens.uss"/>
  <ui:VisualElement name="screen-root" class="tn-screen pv2-screen">
    <ui:VisualElement name="environment-atmosphere" class="tn-screen-background pv2-background" picking-mode="Ignore"/>
    <ui:VisualElement class="pv2-frame">
      <ui:VisualElement class="pv2-topbar"><ui:Button name="screen-back" text="‹" class="tan-icon-button"/><ui:Label name="screen-title" text="ROUND 1 / 5" class="pv2-top-title"/><ui:Label name="screen-status" text="" class="tan-badge tan-badge--info"/></ui:VisualElement>
      <ui:VisualElement class="pv2-content"><ui:Label name="scenario-title" text="THE ROYAL NECKLACE" class="tn-headline"/>
        <ui:VisualElement name="primary-content" class="pv2-primary-content">
          <ui:VisualElement class="pv2-game-layout">
            <ui:VisualElement class="pv2-game-rail"><ui:Label text="DISCUSSION" class="tn-headline"/><ui:VisualElement class="tan-panel"><ui:Label text="Share clues and question the room." class="tn-body"/><ui:Button name="go-chat" text="OPEN CHAT" class="tan-button tan-button--secondary"/></ui:VisualElement><ui:Button name="go-vote" text="CALL / OPEN VOTE" class="tan-button tan-button--primary"/></ui:VisualElement>
            <ui:VisualElement class="pv2-table"><ui:Label text="ROYAL TABLE" class="tn-headline"/><ui:Label text="♢" class="pv2-necklace"/><ui:Label name="game-phase" text="DISCUSSION" class="tn-body"/><ui:VisualElement name="game-player-seats" class="pv2-seat-layer"/></ui:VisualElement>
            <ui:VisualElement class="pv2-game-rail"><ui:VisualElement class="tan-timer"><ui:Label text="REMAINING" class="tan-timer__heading"/><ui:Label name="timer" text="03:00" class="tan-timer__time"/></ui:VisualElement><ui:Button name="go-settings" text="SETTINGS" class="tan-button tan-button--ghost"/><ui:Button name="show-exit-confirmation" text="LEAVE MATCH" class="tan-button tan-button--ghost"/></ui:VisualElement>
          </ui:VisualElement>
        </ui:VisualElement>
      </ui:VisualElement>
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
