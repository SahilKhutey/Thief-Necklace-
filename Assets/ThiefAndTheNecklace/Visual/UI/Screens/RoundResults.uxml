<ui:UXML xmlns:ui="UnityEngine.UIElements"><Style src="../Foundations/Resources/DesignTokens.uss"/><Style src="../USS/TANComponents.uss"/><Style src="PV2Screens.uss"/><ui:VisualElement name="screen-root" class="tn-screen pv2-screen"><ui:VisualElement class="tn-screen-background pv2-background"/><ui:VisualElement class="pv2-frame"><ui:VisualElement class="pv2-topbar"><ui:Button name="screen-back" text="‹" class="tan-icon-button"/><ui:Label name="screen-title" text="ROUND RESULTS" class="pv2-top-title"/><ui:Label name="screen-status" text="" class="tan-badge tan-badge--info"/></ui:VisualElement><ui:VisualElement class="pv2-content"><ui:Label name="screen-subtitle" text="THE ROUND IS COMPLETE" class="tn-headline"/><ui:VisualElement name="primary-content" class="pv2-primary-content"><ui:Label text="ROUND RESULTS" class="pv2-screen-heading"/><ui:VisualElement class="tan-panel"><ui:Label text="YOUR ROUND SCORE · TOTAL" class="tn-headline"/><ui:Label name="score" text="+ 0" class="tan-score__delta"/><ui:Label name="total-score" text="0" class="tn-headline"/><ui:VisualElement name="rank-list" class="pv2-rank-list"/></ui:VisualElement><ui:Button name="go-scenario-intro" text="NEXT ROUND" class="tan-button tan-button--primary"/></ui:VisualElement></ui:VisualElement><ui:VisualElement name="screen-overlay" class="tn-screen-overlay"/></ui:VisualElement></ui:VisualElement></ui:UXML>
