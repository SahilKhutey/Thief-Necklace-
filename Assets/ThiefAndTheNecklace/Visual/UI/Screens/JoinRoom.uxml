<ui:UXML xmlns:ui="UnityEngine.UIElements"><Style src="../Foundations/Resources/DesignTokens.uss"/><Style src="../USS/TANComponents.uss"/><Style src="PV2Screens.uss"/><ui:VisualElement name="screen-root" class="tn-screen pv2-screen"><ui:VisualElement class="tn-screen-background pv2-background"/><ui:VisualElement class="pv2-frame"><ui:VisualElement class="pv2-topbar"><ui:Button name="screen-back" text="‹" class="tan-icon-button"/><ui:Label name="screen-title" text="JOIN ROOM" class="pv2-top-title"/><ui:Label name="screen-status" text="" class="tan-badge tan-badge--info"/></ui:VisualElement><ui:VisualElement class="pv2-content"><ui:Label name="screen-subtitle" text="Enter a room code" class="tn-headline"/><ui:VisualElement name="primary-content" class="pv2-primary-content"><ui:Label text="JOIN ROOM" class="pv2-screen-heading"/><ui:Label text="Enter a room code" class="tn-body"/><ui:TextField name="room-code" label="ROOM CODE" value="A7K2Q"/><ui:Label name="validation-message" text="" class="tn-state-error"/><ui:Button name="join-room-submit" text="JOIN" class="tan-button tan-button--primary"/><ui:Button name="go-lobby" text="FIND A RANDOM MATCH" class="tan-button tan-button--secondary"/><ui:Button name="screen-back" text="BACK" class="tan-button tan-button--ghost"/></ui:VisualElement></ui:VisualElement><ui:VisualElement name="screen-overlay" class="tn-screen-overlay"/></ui:VisualElement></ui:VisualElement></ui:UXML>