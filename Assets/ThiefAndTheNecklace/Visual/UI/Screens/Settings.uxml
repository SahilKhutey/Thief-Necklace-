<ui:UXML xmlns:ui="UnityEngine.UIElements"><Style src="../Foundations/Resources/DesignTokens.uss"/><Style src="../USS/TANComponents.uss"/><Style src="PV2Screens.uss"/><ui:VisualElement name="screen-root" class="tn-screen pv2-screen"><ui:VisualElement class="tn-screen-background pv2-background"/><ui:VisualElement class="pv2-frame"><ui:VisualElement class="pv2-topbar"><ui:Button name="screen-back" text="‹" class="tan-icon-button"/><ui:Label name="screen-title" text="SETTINGS" class="pv2-top-title"/><ui:Label name="screen-status" text="" class="tan-badge tan-badge--info"/></ui:VisualElement><ui:VisualElement class="pv2-content"><ui:Label name="screen-subtitle" text="PRESENTATION &amp; ACCESSIBILITY" class="tn-headline"/><ui:VisualElement name="primary-content" class="pv2-primary-content"><ui:Label text="SETTINGS" class="pv2-screen-heading"/><ui:Label text="PRESENTATION &amp; ACCESSIBILITY" class="tn-body"/><ui:Toggle label="High contrast"/><ui:Toggle label="Reduced motion"/><ui:Toggle label="Large text"/><ui:Slider name="ui-scale" label="UI scale" low-value="1" high-value="1.5" value="1"/><ui:DropdownField label="LANGUAGE" choices="English"/><ui:Button name="screen-back" text="DONE" class="tan-button tan-button--primary"/></ui:VisualElement></ui:VisualElement><ui:VisualElement name="screen-overlay" class="tn-screen-overlay"/></ui:VisualElement></ui:VisualElement></ui:UXML>