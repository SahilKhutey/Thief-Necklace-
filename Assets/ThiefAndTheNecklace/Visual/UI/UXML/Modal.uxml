<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="../Foundations/Resources/DesignTokens.uss" />
    <Style src="../USS/TANComponents.uss" />
    <ui:VisualElement name="modal" class="tan-modal">
        <ui:VisualElement name="backdrop" class="tan-modal__backdrop" />
        <ui:VisualElement name="frame" class="tan-modal__frame">
            <ui:VisualElement class="tan-modal__header-row">
                <ui:Label name="header" class="tan-modal__header" />
                <ui:Button name="close" text="×" class="tan-modal__close" />
            </ui:VisualElement>
            <ui:VisualElement name="body" class="tan-modal__body" />
            <ui:VisualElement name="actions" class="tan-modal__actions" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
